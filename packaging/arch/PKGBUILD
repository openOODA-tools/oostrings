# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oostrings-bin
_pkgname=oostrings
pkgver=0.1.0
pkgrel=1
pkgdesc="Scans binary binaries and memory dumps for printable UTF-8 and ASCII sequences."
arch=('x86_64')
url="https://github.com/openOODA-tools/oostrings"
license=('Apache-2.0')
depends=('glibc')
provides=('oostrings')
conflicts=('oostrings')
source_x86_64=("${url}/releases/download/v${pkgver}/oostrings-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oostrings-linux-x86_64" "${pkgdir}/usr/bin/oostrings"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oostrings-uninstall"
}
